# Sanity project (leave empty to run the site in demo mode from content/demo.ts)
NEXT_PUBLIC_SANITY_PROJECT_ID=z5112m0c
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-14

# Public site origin used by metadata, sitemap and hreflang. Placeholder until the
# marketing./landing. subdomain is decided — no hard failure on mismatch.
NEXT_PUBLIC_SITE_URL=https://www.theaquariumsolution.com

# Server-only. Viewer token: enables draft mode, live draft events and the
# Presentation tool handshake. Create at manage.sanity.io → API → Tokens.
SANITY_API_READ_TOKEN=

# Optional: `x-revalidate-secret` header for POST /api/revalidate
SANITY_REVALIDATE_SECRET=

# Contact form email transport (server-side only)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
TO_EMAIL=
